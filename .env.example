# ============================================
# SERVER CONFIGURATION
# ============================================
# Environment mode: 'development' or 'production'
NODE_ENV=development

# Port number for the server to listen on
PORT=3000

# Frontend application URL (for CORS configuration)
CLIENT_URL=http://localhost:5173

# ============================================
# JWT AUTHENTICATION
# ============================================
# Secret key for signing access tokens (short-lived)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_JWT_SECRET=your_access_secret_here

# Secret key for signing refresh tokens (long-lived)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
REFRESH_JWT_SECRET=your_refresh_secret_here

# Token expiry times (JWT format: 1h, 7d, 30m, etc.)
# Default: 1h for access, 7d for refresh
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# ============================================
# DATABASE
# ============================================
# MongoDB connection string
# Local: mongodb://localhost:27017/chatAppDB
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/chatAppDB
DATABASE_URI=mongodb://localhost:27017/chatAppDB

# ============================================
# CLOUDINARY (File Storage)
# ============================================
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# VIDEO/VOICE CALL SETTINGS
# ============================================
# How long the call rings before timing out (milliseconds)
# Default: 45000 (45 seconds)
CALL_RING_TIMEOUT=45000

# Maximum duration for a single call (milliseconds)
# Default: 14400000 (4 hours)
CALL_MAX_DURATION=14400000

# ============================================
# CLEANUP & MAINTENANCE
# ============================================
# How often to run cleanup tasks (milliseconds)
# Default: 300000 (5 minutes)
CLEANUP_INTERVAL=300000

# How long before entries are considered stale (milliseconds)
# Default: 1800000 (30 minutes)
STALE_THRESHOLD=1800000
